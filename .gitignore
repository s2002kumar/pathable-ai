# --- Environment -------------------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Node / pnpm -------------------------------------------------------------
node_modules/
# Copied from node_modules by scripts/sync-maplibre-worker.mjs on predev/prebuild.
# Generated rather than committed so it cannot drift from the installed version.
apps/web/public/maplibre/
.pnpm-store/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Test output & artifacts -------------------------------------------------
coverage/
.nyc_output/
test-results/
test-results-fullstack/
playwright-report/
playwright-report-fullstack/
blob-report/
.playwright/
artifacts/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
# Generated by `pnpm check:full` / CI to feed pip-audit.
requirements-audit.txt
# Gitleaks report produced by the security workflow.
gitleaks.sarif

# --- Editors / OS ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*

# Cached Overpass responses. Re-downloadable, large, and licensed OSM data that
# does not belong in version control — the dataset in the database is the record.
.osm-cache/
services/api/.osm-cache/

# Downloaded OpenStreetMap extracts. Hundreds of megabytes, re-downloadable, and
# ODbL data that belongs in the database with its provenance rather than in git.
.osm-data/
services/api/.osm-data/

# Regional Overture extracts. Reproducible from the manifest committed as
# evidence, ODbL-licensed, and never meant to live in version control.
.overture-data/
services/api/.overture-data/

# Frozen City of Kitchener snapshots and their normalized GeoParquet. Tens of
# megabytes, identified by the manifests committed as evidence, and the raw
# snapshot holds staff user names that must not be published.
.kitchener-data/
services/api/.kitchener-data/
