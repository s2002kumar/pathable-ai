# =============================================================================
# PathAble AI — example environment
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. This file contains PLACEHOLDERS ONLY and must never
# contain a real credential, token or production hostname.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend (services/api)
# -----------------------------------------------------------------------------

# development | test | production
# `production` additionally requires DATABASE_URL, at least one explicit
# ALLOWED_ORIGINS entry, no "*" origin, and LOG_FORMAT=json. Startup fails
# loudly and lists every problem at once if any of those are missing.
ENVIRONMENT=development

# Interface the API binds to.
#   127.0.0.1 for native development (not reachable from other machines)
#   0.0.0.0   inside Docker, so the container port can be published
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated exact origins allowed to call the API from a browser.
# No trailing slashes — browsers compare the Origin header byte-for-byte.
# "*" is accepted outside production only. Credentialed CORS is never enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# json    — one JSON object per line, for log ingestion (required in production)
# console — compact human-readable output, nicer for local development
LOG_FORMAT=console

# Regions whose routing graph is loaded at startup, comma-separated. Leave
# empty for development: graphs then load on the first request that needs them.
# A deployment should set this to its pilot region(s) — readiness stays 503
# until every listed graph is loaded, so no traffic reaches an instance that
# would spend its first twenty seconds building one.
GRAPH_PRELOAD_REGIONS=

# Upper bound on the readiness database probe, in seconds (0 < value <= 30).
READINESS_TIMEOUT_SECONDS=2.0

# -----------------------------------------------------------------------------
# Geocoding (optional)
# -----------------------------------------------------------------------------
# Place-name search is a convenience on top of choosing points on the map, and it
# is off unless you turn it on. Leaving it off is a reasonable production choice.
#
#   none      — no search. The UI says so rather than reporting "no results".
#   nominatim — OpenStreetMap's own geocoder. Free, no account, and strictly
#               rate-limited: PathAble sends at most one request per second and
#               never searches as you type. Exceeding the policy gets the whole
#               application blocked, not throttled.
GEOCODING_PROVIDER=none

# Required when GEOCODING_PROVIDER=nominatim. Nominatim's usage policy requires a
# contact address so an operator can reach you before blocking you. Startup fails
# without one.
GEOCODING_CONTACT=


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# These three are consumed by the `db` Compose service to initialise the volume.
# They are local development credentials for a database that is not exposed
# beyond your machine. Never reuse them anywhere real.
POSTGRES_USER=pathable
POSTGRES_PASSWORD=pathable_local_dev_only
POSTGRES_DB=pathable

# Host port for the Compose database.
#
# 5433, not 5432, on purpose: a locally installed PostgreSQL commonly already
# owns 5432, and Compose would fail to bind with a confusing "port is already
# allocated" error. Change this if 5433 is taken too.
DB_PORT=5433

# Host port for the web app.
WEB_PORT=3000

# DATABASE_URL differs depending on where the API runs.
#
#   Docker Compose  -> host is the `db` service name, port is the container's 5432.
#                      compose.yaml sets this for the api service already; you do
#                      not need to change it here.
#   Native (pnpm dev) -> host is localhost and the port is DB_PORT above.
#
# The value below is the NATIVE one, because .env is what native development
# reads. `postgresql://` is accepted and normalised to `postgresql+psycopg://`.
DATABASE_URL=postgresql+psycopg://pathable:pathable_local_dev_only@localhost:5433/pathable


# -----------------------------------------------------------------------------
# Frontend (apps/web)
#
# WARNING: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle and is
# readable by anyone who visits the site. Never put a secret, API key or private
# hostname behind a NEXT_PUBLIC_ prefix.
# -----------------------------------------------------------------------------

# Base URL the browser uses to reach the API. Origin only, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# MapLibre style document.
#
# OpenFreeMap requires no account, no API key and no payment, which makes it a
# good default for development. It has NOT been approved for production use —
# see docs/licensing/DATA_SOURCES.md before shipping this anywhere public.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Pilot region. Waterloo, Ontario by default; the geography is configuration,
# not a hard-coded assumption.
#   latitude  -90 .. 90
#   longitude -180 .. 180
#   zoom       0 .. 22
NEXT_PUBLIC_PILOT_CENTER_LAT=43.4668
NEXT_PUBLIC_PILOT_CENTER_LON=-80.5164
NEXT_PUBLIC_PILOT_ZOOM=14
NEXT_PUBLIC_PILOT_REGION_NAME=Waterloo, Ontario

# Must match a pilot region slug the API knows (`pathable regions list`).
# Lowercase letters, digits and hyphens only.
NEXT_PUBLIC_PILOT_REGION_SLUG=waterloo
