            "items": {
              "type": "string"
            },
            "title": "Unknown Attributes",
            "type": "array"
          },
          "width_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recorded width. Null means unrecorded, not narrow.",
            "title": "Width M"
          }
