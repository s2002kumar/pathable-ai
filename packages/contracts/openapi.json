                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steepest Incline Percent"
          },
          "step_count": {
            "description": "Recorded steps across all stairways on this route.",
            "title": "Step Count",
            "type": "integer"
          },
          "unknown_data_fraction": {
