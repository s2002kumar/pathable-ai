{
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "description": "Uniform error envelope.",
        "examples": [
          {
            "code": "not_found",
            "message": "The requested resource does not exist.",
            "request_id": "9f1c2b7a4e5d4f0aa1b2c3d4e5f60718"
          }
        ],
        "properties": {
          "code": {
            "description": "Stable machine-readable error identifier. Safe to branch on; the human-readable 'message' is not.",
            "examples": [
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Field-level problems. Populated for validation errors only.",
            "title": "Details"
          },
          "message": {
            "description": "Human-readable summary, safe to display. Never contains internals.",
            "examples": [
              "An unexpected error occurred."
            ],
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlation id for this request; quote it when reporting a problem.",
            "examples": [
              "9f1c2b7a4e5d4f0aa1b2c3d4e5f60718"
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "CautionModel": {
        "description": "Something to weigh before relying on the route.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": true,
            "title": "Evidence",
            "type": "object"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "code",
          "summary"
        ],
        "title": "CautionModel",
        "type": "object"
      },
      "Coordinate": {
        "description": "A WGS84 position.",
        "properties": {
          "latitude": {
            "description": "Degrees north of the equator.",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "description": "Degrees east of the prime meridian.",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "longitude",
          "latitude"
        ],
        "title": "Coordinate",
        "type": "object"
      },
      "CostComponentModel": {
        "description": "One contribution to a segment's cost.",
        "properties": {
          "code": {
            "enum": [
              "distance",
              "surface",
              "smoothness",
              "incline",
              "steps",
              "kerb",
              "crossing",
              "width",
              "uncertainty"
            ],
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "Plain-language reason, derived from recorded attributes.",
            "title": "Detail",
            "type": "string"
          },
          "effective_metres": {
            "description": "Effective metres this contribution added.",
            "title": "Effective Metres",
            "type": "number"
          }
        },
        "required": [
          "code",
          "effective_metres",
          "detail"
        ],
        "title": "CostComponentModel",
        "type": "object"
      },
      "CustomProfileOptions": {
        "description": "Overrides for the ``custom`` profile.\n\nDeliberately narrow. Exposing every cost weight would let a client build a\nmodel nobody has reasoned about, and the resulting route would still carry\nPathAble's name.",
        "properties": {
          "avoid_rough_surface": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Treat gravel, dirt and cobblestone as impassable.",
            "title": "Avoid Rough Surface"
          },
          "base": {
            "default": "wheelchair",
            "description": "Preset the custom profile starts from.",
            "enum": [
              "wheelchair",
              "walker",
              "crutches",
              "stroller",
              "reduced_mobility"
            ],
            "title": "Base",
            "type": "string"
          },
          "exclude_steps": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Treat stairways as impassable.",
            "title": "Exclude Steps"
          },
          "max_incline_percent": {
            "anyOf": [
              {
                "maximum": 45.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Steepest recorded gradient to allow. Unrecorded gradients are never excluded.",
            "title": "Max Incline Percent"
          },
          "min_width_m": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Narrowest recorded width to allow. Unrecorded widths are never excluded.",
            "title": "Min Width M"
          }
        },
        "title": "CustomProfileOptions",
        "type": "object"
      },
      "DatasetProvenance": {
        "description": "Which network answered this request.",
        "properties": {
          "acquired_at": {
            "description": "When PathAble obtained this dataset, ISO 8601. Not how old the map is.",
            "title": "Acquired At",
            "type": "string"
          },
          "attribution": {
            "description": "Required credit for the underlying map data.",
            "examples": [
              "© OpenStreetMap contributors, ODbL 1.0"
            ],
            "title": "Attribution",
            "type": "string"
          },
          "checksum": {
            "description": "Content hash of the dataset that produced this route.",
            "title": "Checksum",
            "type": "string"
          },
          "dataset_id": {
            "title": "Dataset Id",
            "type": "string"
          },
          "evidence_age_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whole days between the upstream publication and this response. Null when the source published no timestamp. A route cannot say a particular crossing was surveyed years ago — OpenStreetMap element timestamps are not yet ingested — so this is the age of the dataset, not of any individual fact in it.",
            "title": "Evidence Age Days"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "source_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the upstream source published this data, ISO 8601. This is the figure that says how current the map is; `acquired_at` only says when it was fetched. Null when the source published no timestamp.",
            "title": "Source Timestamp"
          },
          "source_type": {
            "enum": [
              "osm",
              "synthetic"
            ],
            "title": "Source Type",
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "region",
          "checksum",
          "source_type",
          "source_name",
          "acquired_at",
          "attribution"
        ],
        "title": "DatasetProvenance",
        "type": "object"
      },
      "DependencyCheck": {
        "description": "Outcome of probing one dependency.",
        "properties": {
          "detail": {
            "description": "Short, safe explanation. Never includes credentials, connection strings or stack traces.",
            "examples": [
              "connected"
            ],
            "title": "Detail",
            "type": "string"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Observed probe latency in milliseconds, when measured.",
            "examples": [
              4.21
            ],
            "title": "Latency Ms"
          },
          "status": {
            "description": "Whether this dependency is usable.",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "A single field-level problem, used for request-validation failures.",
        "properties": {
          "field": {
            "description": "Dotted path to the offending input, e.g. 'body.origin.lat'.",
            "examples": [
              "query.zoom"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "description": "Human-readable explanation of why this input was rejected.",
            "examples": [
              "Input should be less than or equal to 22"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ExplanationModel": {
        "description": "An evidence-backed statement about why the accessible route differs.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": true,
            "description": "The recorded values this statement was derived from.",
            "title": "Evidence",
            "type": "object"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "code",
          "summary"
        ],
        "title": "ExplanationModel",
        "type": "object"
      },
      "GeocodeMatch": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the provider called this — a road, a building, a suburb.",
            "title": "Category"
          },
          "label": {
            "description": "Human-readable description, as the provider wrote it.",
            "title": "Label",
            "type": "string"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "label",
          "longitude",
          "latitude"
        ],
        "title": "GeocodeMatch",
        "type": "object"
      },
      "GeocodeRequest": {
        "description": "Look up a place name within a pilot region.",
        "examples": [
          {
            "query": "Waterloo Public Square",
            "region": "waterloo"
          }
        ],
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "description": "Place name or address to look for.",
            "maxLength": 160,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "region": {
            "default": "waterloo",
            "description": "Pilot region slug; results are restricted to its extent.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "GeocodeRequest",
        "type": "object"
      },
      "GeocodeResponse": {
        "properties": {
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Credit the provider's licence requires.",
            "title": "Attribution"
          },
          "enabled": {
            "description": "False when no geocoder is configured. An empty `matches` with `enabled: false` means nothing was searched, not that nothing was found.",
            "title": "Enabled",
            "type": "boolean"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/GeocodeMatch"
            },
            "title": "Matches",
            "type": "array"
          },
          "provider": {
            "description": "Which geocoder answered, or 'disabled'.",
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "enabled",
          "matches"
        ],
        "title": "GeocodeResponse",
        "type": "object"
      },
      "KerbType": {
        "description": "Kerb (curb) treatment where a path meets a road.\n\nOrdered best to worst for a wheeled user: ``NONE`` (the mapper states there\nis no kerb at all) is the best case, then ``FLUSH``, then ``LOWERED``.\n\n``ROLLED`` is its own tier rather than a kind of lowered kerb. The OSM wiki\nis explicit that a rolled kerb is \"traversable by large wheeled vehicles,\nsuch as cars and bicycles, but not wheelchairs\" — folding it into ``LOWERED``\npriced a wheelchair barrier at zero.\n\n``PRESENT_UNKNOWN`` is \"a kerb is definitely here, nobody recorded its\nheight\" — a `barrier=kerb` node or `kerb=yes`. That is strictly stronger\nevidence than ``UNKNOWN``, which means nothing was mapped at all, and the two\nshould not cost the same.",
        "enum": [
          "none",
          "flush",
          "lowered",
          "rolled",
          "present_unknown",
          "raised",
          "unknown"
        ],
        "title": "KerbType",
        "type": "string"
      },
      "LivenessResponse": {
        "description": "Process is running and able to serve HTTP.",
        "examples": [
          {
            "service": "pathable-api",
            "status": "ok",
            "version": "0.1.0"
          }
        ],
        "properties": {
          "service": {
            "description": "Service identifier.",
            "examples": [
              "pathable-api"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "description": "Always 'ok'; a non-2xx status signals failure.",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Deployed application version.",
            "examples": [
              "0.1.0"
            ],
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "MobilityProfileListResponse": {
        "properties": {
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/MobilityProfileModel"
            },
            "title": "Profiles",
            "type": "array"
          }
        },
        "required": [
          "profiles"
        ],
        "title": "MobilityProfileListResponse",
        "type": "object"
      },
      "MobilityProfileModel": {
        "description": "A profile a client can offer.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "excludes_steps": {
            "description": "Whether stairways are excluded outright for this profile.",
            "title": "Excludes Steps",
            "type": "boolean"
          },
          "hard_requirements": {
            "description": "Plain statements of what this traveller cannot use. Empty when nothing is excluded.",
            "items": {
              "type": "string"
            },
            "title": "Hard Requirements",
            "type": "array"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "max_incline_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "A hard limit: recorded gradients above this are excluded. Null for every preset — a preset expresses gradient as preference, not impossibility.",
            "title": "Max Incline Percent"
          },
          "min_width_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "A hard limit: recorded widths below this are excluded.",
            "title": "Min Width M"
          },
          "prefers_gradient_under_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Guidance, not a limit. Steeper segments cost far more but remain available when the only alternative is no route.",
            "title": "Prefers Gradient Under Percent"
          },
          "prefers_width_over_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Guidance, not a limit.",
            "title": "Prefers Width Over M"
          }
        },
        "required": [
          "key",
          "display_name",
          "description",
          "excludes_steps"
        ],
        "title": "MobilityProfileModel",
        "type": "object"
      },
      "ReadinessChecks": {
        "description": "Per-dependency readiness results.",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyCheck",
            "description": "PostgreSQL connectivity."
          },
          "postgis": {
            "$ref": "#/components/schemas/DependencyCheck",
            "description": "PostGIS extension availability."
          }
        },
        "required": [
          "database",
          "postgis"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Aggregate readiness verdict.\n\nReturned with HTTP 200 when ``status`` is ``ready`` and HTTP 503 when it is\n``not_ready``; the body shape is identical either way so clients parse once.",
        "examples": [
          {
            "checks": {
              "database": {
                "detail": "connected",
                "latency_ms": 4.21,
                "status": "ok"
              },
              "postgis": {
                "detail": "postgis 3.4.2",
                "latency_ms": 1.08,
                "status": "ok"
              }
            },
            "service": "pathable-api",
            "status": "ready",
            "version": "0.1.0"
          }
        ],
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks",
            "description": "Individual dependency results."
          },
          "service": {
            "description": "Service identifier.",
            "examples": [
              "pathable-api"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "'ready' only when every dependency check succeeded.",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Deployed application version.",
            "examples": [
              "0.1.0"
            ],
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RouteCompareRequest": {
        "description": "Ask for the shortest route and an accessibility-aware alternative.",
        "examples": [
          {
            "destination": {
              "latitude": 43.4723,
              "longitude": -80.5204
            },
            "origin": {
              "latitude": 43.4643,
              "longitude": -80.5449
            },
            "profile": "wheelchair",
            "region": "waterloo"
          }
        ],
        "properties": {
          "custom": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CustomProfileOptions"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only used when `profile` is `custom`; ignored otherwise."
          },
          "destination": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "origin": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "profile": {
            "default": "wheelchair",
            "description": "Mobility profile for the accessible route.",
            "enum": [
              "wheelchair",
              "walker",
              "crutches",
              "stroller",
              "reduced_mobility",
              "custom"
            ],
            "title": "Profile",
            "type": "string"
          },
          "region": {
            "default": "waterloo",
            "description": "Pilot region slug.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "origin",
          "destination"
        ],
        "title": "RouteCompareRequest",
        "type": "object"
      },
      "RouteCompareResponse": {
        "description": "The shortest route, the accessible route, and the difference between them.",
        "properties": {
          "accessible_failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why no route satisfies the chosen profile.",
            "title": "Accessible Failure"
          },
          "accessible_route": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RouteModel"
              },
              {
                "type": "null"
              }
            ],
            "description": "Route meeting the chosen profile. Null when no such route exists."
          },
          "cautions": {
            "items": {
              "$ref": "#/components/schemas/CautionModel"
            },
            "title": "Cautions",
            "type": "array"
          },
          "dataset": {
            "$ref": "#/components/schemas/DatasetProvenance"
          },
          "explanations": {
            "items": {
              "$ref": "#/components/schemas/ExplanationModel"
            },
            "title": "Explanations",
            "type": "array"
          },
          "extra_distance_fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra Distance Fraction"
          },
          "extra_distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "How much further the accessible route is.",
            "title": "Extra Distance M"
          },
          "ml_predictions_used": {
            "const": false,
            "default": false,
            "description": "Always false. PathAble's routing is deterministic rules over recorded map attributes; no model prediction contributes to any cost or constraint.",
            "title": "Ml Predictions Used",
            "type": "boolean"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "profile_description": {
            "title": "Profile Description",
            "type": "string"
          },
          "profile_display_name": {
            "title": "Profile Display Name",
            "type": "string"
          },
          "routing_policy_version": {
            "description": "Which cost and constraint policy produced this route. Bumped whenever a change would move a route, so two results can be compared meaningfully.",
            "title": "Routing Policy Version",
            "type": "integer"
          },
          "standard_failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the shortest route could not be computed.",
            "title": "Standard Failure"
          },
          "standard_route": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RouteModel"
              },
              {
                "type": "null"
              }
            ],
            "description": "Shortest walking route. Null when none exists."
          }
        },
        "required": [
          "profile",
          "profile_display_name",
          "profile_description",
          "explanations",
          "cautions",
          "dataset",
          "routing_policy_version"
        ],
        "title": "RouteCompareResponse",
        "type": "object"
      },
      "RouteModel": {
        "description": "A computed route.",
        "properties": {
          "computation_ms": {
            "title": "Computation Ms",
            "type": "number"
          },
          "coordinates": {
            "description": "[longitude, latitude] polyline for the whole route.",
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Coordinates",
