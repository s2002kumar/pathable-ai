        "required": [
          "edge_identity",
          "length_m",
          "effective_metres",
          "coordinates",
          "surface_class",
          "smoothness_class",
          "steps",
          "kerb",
          "is_crossing",
          "unknown_attributes",
          "cost_components"
        ],
        "title": "RouteSegmentModel",
        "type": "object"
      },
      "SmoothnessClass": {
        "description": "Coarse grouping of OSM `smoothness`.",
        "enum": [
          "excellent",
          "good",
          "intermediate",
          "bad",
          "unknown"
        ],
        "title": "SmoothnessClass",
        "type": "string"
      },
      "SnappedPointModel": {
        "description": "Where a requested coordinate joined the network.",
        "properties": {
          "distance_m": {
            "description": "How far the requested point was from the nearest mapped path.",
            "title": "Distance M",
            "type": "number"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "longitude",
          "latitude",
          "distance_m"
        ],
        "title": "SnappedPointModel",
        "type": "object"
      },
      "SurfaceClass": {
        "description": "Coarse surface grouping used by the cost model.\n\nThe raw OSM `surface` value is kept alongside this; the class exists so cost\npolicy is written against four cases rather than the ~40 values in the wild.",
        "enum": [
          "paved",
          "compacted",
          "rough",
          "unknown"
        ],
        "title": "SurfaceClass",
        "type": "string"
      },
      "TriState": {
        "description": "Yes / no / unknown.\n\n``UNKNOWN`` is the default for every derived attribute. ``NO`` means there is\naffirmative evidence of absence, not merely a missing tag.",
        "enum": [
          "yes",
          "no",
          "unknown"
        ],
        "title": "TriState",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Backend for **PathAble AI**, an accessibility-aware pedestrian routing project.\n\nRouting compares the shortest walking route against a route that respects a chosen\nmobility profile, and explains the difference using attributes recorded in\nOpenStreetMap.\n\n**What this is not.** Every routing decision is a deterministic rule over recorded\nmap attributes. There is no machine learning, no model prediction and no inferred\naccessibility score anywhere in this service — `ml_predictions_used` is present on\nevery route response and is always `false`. Missing accessibility data is reported\nas `unknown`, never as evidence that a path is clear, and no route is a guarantee\nthat a journey is passable.\n\nMap data © OpenStreetMap contributors, ODbL 1.0.",
    "title": "PathAble AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/geocode/search": {
      "post": {
        "description": "Searches for a place within a pilot region's extent. Submit-only: there is no as-you-type endpoint, because per-keystroke queries against a donated geocoding service are forbidden by its usage policy. Nothing about the request is stored.",
        "operationId": "searchPlaces",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeocodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "The region does not exist."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the expected schema."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error. Quote the request id when reporting."
          },
          "503": {
            "description": "The geocoding provider failed."
          }
        },
        "summary": "Find coordinates for a place name",
        "tags": [
          "geocoding"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "Reports that the process is running and able to serve HTTP. Touches no dependency, so a database outage never causes an orchestrator to restart an otherwise healthy instance. Use /health/ready for traffic gating.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the expected schema."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error. Quote the request id when reporting."
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Reports whether this instance should receive traffic. Probes PostgreSQL connectivity and PostGIS availability under a bounded timeout. Returns 200 when ready and 503 when not; the body shape is identical in both cases.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the expected schema."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error. Quote the request id when reporting."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "One or more dependencies are unavailable."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/routes/compare": {
      "post": {
        "description": "Computes the shortest walking route and a route that respects the chosen mobility profile, and explains the difference using attributes recorded in OpenStreetMap. Either route may be absent — a profile with no possible route is a real answer, and the response says why. No part of the request is stored.",
        "operationId": "compareRoutes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteCompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteCompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "The region has no active network dataset."
          },
          "422": {
            "description": "The request could not be routed as given."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error. Quote the request id when reporting."
          }
        },
        "summary": "Compare the shortest route with an accessibility-aware route",
        "tags": [
          "routing"
        ]
      }
    },
    "/api/v1/routes/profiles": {
      "get": {
        "description": "The profiles a client may offer, with the hard constraints each one applies. Constraint values are engineering judgement, not measurements of how people with these mobility aids actually travel.",
        "operationId": "listMobilityProfiles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobilityProfileListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "The request did not match the expected schema."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error. Quote the request id when reporting."
          }
        },
        "summary": "List mobility profiles",
        "tags": [
          "routing"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes used by Docker, CI and the web client.",
      "name": "health"
    },
    {
      "description": "Accessibility-aware pedestrian routing over a versioned OpenStreetMap network. Requests are not persisted.",
      "name": "routing"
    },
    {
      "description": "Optional place-name search, restricted to a pilot region. Disabled unless a provider is configured.",
      "name": "geocoding"
    }
  ]
}
