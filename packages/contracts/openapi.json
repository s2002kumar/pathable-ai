          "profile_display_name",
          "distance_m",
          "effective_distance_m",
          "estimated_duration_seconds",
          "coordinates",
          "segments",
          "origin",
          "destination",
          "stairway_count",
          "step_count",
          "crossing_count",
          "unknown_kerb_crossing_count",
          "steepest_incline_percent",
          "unknown_data_fraction",
          "computation_ms"
        ],
        "title": "RouteModel",
        "type": "object"
      },
      "RouteSegmentModel": {
        "description": "One mapped segment as traversed by a route.",
        "properties": {
          "coordinates": {
            "description": "[longitude, latitude] positions, oriented along travel.",
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Coordinates",
            "type": "array"
          },
          "cost_components": {
            "items": {
              "$ref": "#/components/schemas/CostComponentModel"
            },
            "title": "Cost Components",
            "type": "array"
          },
          "edge_identity": {
            "description": "Stable identity of this segment within the dataset.",
            "title": "Edge Identity",
            "type": "string"
          },
          "effective_metres": {
            "description": "What this segment cost the chosen profile, in effective metres.",
            "title": "Effective Metres",
            "type": "number"
          },
          "highway": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Highway"
          },
          "incline_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recorded gradient. Null means unrecorded, not flat.",
            "title": "Incline Percent"
          },
          "is_crossing": {
            "title": "Is Crossing",
            "type": "boolean"
          },
          "kerb": {
            "$ref": "#/components/schemas/KerbType"
          },
          "length_m": {
            "title": "Length M",
            "type": "number"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Street or path name, when OSM records one.",
            "title": "Name"
          },
          "smoothness_class": {
            "$ref": "#/components/schemas/SmoothnessClass"
          },
          "step_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Count"
          },
          "steps": {
            "$ref": "#/components/schemas/TriState",
            "description": "Whether this segment is a stairway. `unknown` means nobody has recorded it."
          },
          "surface": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Raw OSM surface value, if recorded.",
            "title": "Surface"
          },
          "surface_class": {
            "$ref": "#/components/schemas/SurfaceClass"
          },
          "unknown_attributes": {
